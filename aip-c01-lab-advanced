    const ref  = fsMod.doc(db, "courseProgress", uid);

    const snap = await fsMod.getDoc(ref);
    const data = snap.exists() ? (snap.data() || {}) : {};
    const mod  = (((data.courses || {})[CP_COURSE_ID] || {}).modules || {})[MODULE_KEY] || {};
    store = { checks: mod.checks || {}, complete: !!mod.complete };

    save = async () => {
      const checks = {};
      boxes.forEach((b, i) => { checks["c" + i] = b.checked; });
      const complete = boxes.every(b => b.checked);
      await fsMod.setDoc(ref, {
        email: email,
        updatedAt: new Date().toISOString(),
        courses: { [CP_COURSE_ID]: { modules: { [MODULE_KEY]: {
          checks: checks,
          complete: complete,
          total: boxes.length,
          done: boxes.filter(b => b.checked).length,
          updatedAt: new Date().toISOString()
        } } } }
      }, { merge: true });
    };

    boxes.forEach((b, i) => { b.checked = !!store.checks["c" + i]; });
    render();
  }

  window.SFAuth.mount(async function(email, signOut){
    document.getElementById('who').innerHTML =
      email + ' <button class="signout" id="signout">Sign out</button>';
    const so = document.getElementById('signout');
    if (so && signOut) so.onclick = () => signOut().then(() => location.reload());

    boxes = Array.prototype.slice.call(
      document.querySelectorAll('.done input[type=checkbox]'));

    try { await bootProgress(email); }
    catch(e){ console.log('[progress] falling back to in-page only:', e && e.message); render(); }

    boxes.forEach(b => b.addEventListener('change', async () => {
      render();
      try { await save(); }
      catch(e){ console.log('[progress] save failed:', e && e.message); }
    }));
  });
})();
</script>

</body>
</html>
